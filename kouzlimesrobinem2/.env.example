# Veřejná adresa webu
NEXT_PUBLIC_SITE_URL=https://kouzlimesrobinem2.vercel.app

# Administrace — do souboru nikdy nevkládejte skutečné hodnoty z produkce
ADMIN_PASSWORD=
ADMIN_SECRET=

# Vercel Blob — přidává automaticky připojené úložiště robin-cms
BLOB_READ_WRITE_TOKEN=

# Neon Postgres — přidává automaticky připojená databáze robin-calendar
DATABASE_URL=

# Volitelné obousměrné propojení Robinova Google Kalendáře
# OAuth redirect: https://kouzlimesrobinem2.vercel.app/api/admin/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ENCRYPTION_KEY=

# Resend — produkční e-mailová upozornění
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile — pro produkci používejte skutečné, nikoli testovací klíče
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
